{
	"label": "Pricing",
	"description": "Plans with price, description, features and a button; one plan can be highlighted (from HyperUI's pricing \"Options with tier, description, price, call to action and features\")",
	"icon": "columns",
	"category": "sections",
	"contentTypes": [ "page" ],
	"fields": [
		{ "name": "eyebrow", "type": "text", "label": "Label above the heading", "maxLength": 60 },
		{ "name": "title", "type": "text", "label": "Heading", "maxLength": 100 },
		{ "name": "intro", "type": "textarea", "label": "Intro", "maxLength": 400 },
		{
			"name": "plans",
			"type": "list",
			"label": "Plans",
			"maxItems": 4,
			"fields": [
				{ "name": "name", "type": "text", "label": "Name", "required": true, "maxLength": 40 },
				{ "name": "description", "type": "textarea", "label": "Description", "maxLength": 200 },
				{ "name": "price", "type": "text", "label": "Price", "help": "As shown, e.g. €29 or Free", "maxLength": 20 },
				{ "name": "period", "type": "text", "label": "Per", "help": "e.g. /month; empty for one-off prices", "maxLength": 20 },
				{ "name": "features", "type": "textarea", "label": "Included", "help": "One feature per line", "maxLength": 1000 },
				{ "name": "buttonLabel", "type": "text", "label": "Button", "maxLength": 40 },
				{ "name": "buttonLink", "type": "link", "label": "Button link" },
				{ "name": "highlighted", "type": "boolean", "label": "Highlight this plan", "default": false }
			]
		},
		{ "name": "badge", "type": "text", "label": "Label of the highlighted plan", "default": "Most popular", "maxLength": 30 },
		{
			"name": "tone",
			"type": "select",
			"label": "Background",
			"default": "light",
			"options": [
				{ "value": "light", "label": "Light" },
				{ "value": "alt", "label": "Light, tinted" },
				{ "value": "dark", "label": "Dark" },
				{ "value": "brand", "label": "Brand color" }
			]
		}
	]
}
